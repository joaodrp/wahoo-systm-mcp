# Test Configuration
# Copy this file to .env and fill in your values
# shellcheck disable=SC2034

# Credentials (plain text)
WAHOO_USERNAME=your_email@example.com
WAHOO_PASSWORD=your_password

# Only for testing the AWS Lambda setup (multi-user, OAuth sign-in) locally with
# `just serve-remote`. On Lambda these come from SSM Parameter Store instead; see `just users`.
# Sign in on the page it opens with an allowed Wahoo SYSTM account.
# MCP_SIGNING_SECRET=at-least-32-random-characters
# MCP_ALLOWED_EMAILS=your_email@example.com,a_friend@example.com
# To test with MCP Inspector, also allow its OAuth callback:
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:6274/oauth/callback
